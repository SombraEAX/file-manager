{
  "name": "file-manager",
  "version": "0.1.0",
  "main": "src/electron-main.js",
  "private": true,
  "scripts": {
    "start": "vue-cli-service build && npx cross-env NODE_ENV=production electron .",
    "serve": "concurrently \"vue-cli-service serve\" \"npx wait-on http://localhost:8081 && npx cross-env NODE_ENV=development electron .\"",
    "build": "vue-cli-service build",
    "lint": "vue-cli-service lint"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/vue3-essential",
      "eslint:recommended"
    ],
    "parserOptions": {
      "parser": "@babel/eslint-parser"
    },
    "rules": {}
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ],
  "_id": "file-manager@0.1.0",
  "readme": "ERROR: No README data found!",
  "dependencies": {
    "@vue/cli-plugin-router": "^5.0.9",
    "@vue/cli-plugin-vuex": "^5.0.9",
    "@vue/cli-service": "^5.0.9",
    "@vue/component-compiler-utils": "^3.3.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "dompurify": "^3.4.1",
    "electron": "^41.3.0",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.2",
    "pretty-bytes": "^7.0.0",
    "serialize-javascript": "^7.0.5",
    "util": "^0.12.5",
    "uuid": "^14.0.0",
    "vue": "^3.5.13",
    "vue-loader": "^17.4.2",
    "webpack-dev-server": "^5.2.3"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "wait-on": "^8.0.3"
  }
}
