{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "outDir": "dist-electron",
    "rootDir": "src",
    "lib": ["es2020", "dom"],
    "types": ["node"]
  },
  "include": ["src/electron-main.ts", "src/preload.ts"]
}
